[configuration]

entry_symbol = "icarus_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libicarus.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libicarus.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libicarus.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libicarus.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libicarus.macos.template_debug.framework"
macos.release = "res://bin/libicarus.macos.template_release.framework"
