#!/usr/bin/env python
# Builds the Code:Icarus GDExtension: the engine-independent kernel (core/) plus the
# thin Godot binding layer (gdext/src). Output goes to game/bin/.
import os

# The kernel uses C++ exceptions for data/save validation.
ARGUMENTS.setdefault("disable_exceptions", "no")

env = SConscript("../thirdparty/godot-cpp/SConstruct")

# godot-cpp archives ~1000 objects in one command. SCons runs commands through `sh -c`,
# which takes the whole line as one argument, and Linux caps a single argument at
# 128 KB; with a long checkout path the archive line exceeds that. Run such lines
# directly (argument by argument) instead - this works for GNU ar, gcc-ar and BSD ar.
if os.name != "nt":
    import shlex
    import subprocess

    default_spawn = env["SPAWN"]
    long_line = int(os.environ.get("ICARUS_LONG_LINE", "100000"))

    def long_line_spawn(sh, escape, cmd, args, spawn_env):
        line = " ".join(args)
        if len(line) < long_line:
            return default_spawn(sh, escape, cmd, args, spawn_env)
        return subprocess.call(shlex.split(line), env={k: str(v) for k, v in spawn_env.items()})

    env["SPAWN"] = long_line_spawn

env.Append(CPPPATH=["src/", "../core/include/"])
# The kernel is written against C++20 (godot-cpp itself only asks for C++17).
env["CXXFLAGS"] = [f for f in env["CXXFLAGS"] if f not in ("-std=c++17", "/std:c++17")]
env.Append(CXXFLAGS=["/std:c++20"] if env.get("is_msvc", False) else ["-std=c++20"])
if env["platform"] == "windows" and env.get("use_mingw", False) is False and env.get("is_msvc", False):
    env.Append(CXXFLAGS=["/fp:precise"])
else:
    env.Append(CXXFLAGS=["-ffp-contract=off"])

core_sources = []
for root, dirs, files in os.walk("../core/src"):
    for f in files:
        if f.endswith(".cpp"):
            core_sources.append(os.path.join(root, f))
sources = Glob("src/*.cpp") + [File(s) for s in sorted(core_sources)]

libname = "icarus"
suffix = env["suffix"].replace(".dev", "").replace(".universal", "")
if env["platform"] == "macos":
    library = env.SharedLibrary(
        "../game/bin/lib{}.{}.{}.framework/lib{}.{}.{}".format(
            libname, env["platform"], env["target"], libname, env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "../game/bin/lib{}{}{}".format(libname, suffix, env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)
